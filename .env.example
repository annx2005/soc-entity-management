APP_NAME=SOC Entity Management
ENVIRONMENT=local
TENANT_ID_DEFAULT=default
JWT_SECRET_KEY=local-dev-change-me-32-bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=sqlite:///./soc_entity_management.db
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
DOCKER_DATABASE_URL=postgresql+psycopg://soc:soc_password@postgresql:5432/soc_entity_management
DOCKER_REDIS_URL=redis://redis:6379/0
DOCKER_NEO4J_URI=bolt://neo4j:7687
DOCKER_NEO4J_USER=neo4j
DOCKER_NEO4J_PASSWORD=neo4j_password

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_EVENTS_TOPIC=soc.raw-events.v1
KAFKA_NORMALIZED_EVENTS_TOPIC=soc.normalized-events.v1
KAFKA_OCSF_EVENTS_TOPIC=soc.ocsf-events.v1
KAFKA_DEAD_LETTER_TOPIC=soc.ingest-dlq.v1
KAFKA_INGESTION_GROUP_ID=soc-ingestion-workers
KAFKA_GRAPH_GROUP_ID=soc-graph-workers
DOCKER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

ENRICHMENT_PROVIDER_MODE=ipinfo_malwarebazaar
ENRICHMENT_IPINFO_TOKEN=
ENRICHMENT_IPINFO_BASE_URL=https://api.ipinfo.io/lite
ENRICHMENT_MALWARE_BAZAAR_AUTH_KEY=
ENRICHMENT_MALWARE_BAZAAR_URL=https://mb-api.abuse.ch/api/v1/
ENRICHMENT_HTTP_TIMEOUT_SECONDS=5
ENRICHMENT_CACHE_TTL_SECONDS=86400
ENRICHMENT_ENABLED=true

VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8000
DOCKER_VITE_API_PROXY_TARGET=http://backend:8000

POSTGRES_USER=soc
POSTGRES_PASSWORD=soc_password
POSTGRES_DB=soc_entity_management
POSTGRES_PORT=5432

REDIS_PORT=6379

KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=INTERNAL://:9092,EXTERNAL://:19092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=INTERNAL://kafka:9092,EXTERNAL://localhost:19092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_EXTERNAL_PORT=19092
KAFKA_UI_PORT=18080

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_AUTH=neo4j/neo4j_password

FRONTEND_PORT=5173
BACKEND_PORT=8000
